# ─── Application ──────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/tapt-api

# ─── Logging ──────────────────────────────────────────
# trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ─── SendGrid (Email) ─────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ─── Sentry (Error Tracking) ─────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─── GrowthBook (Feature Flags) ───────────────────────
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=

# ─── Redis (BullMQ / Caching) ─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── Cloudinary (File Storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Rate Limiting (Throttler) ────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# "false" locally; hop count (e.g. 1) behind a load balancer
TRUST_PROXY=false

# ─── Auth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 48 (min 32 chars)
# Dev default: change before deploying to production
JWT_SECRET=dev-secret-key-that-is-at-least-32-characters-long-for-dev
# Refresh tokens are opaque (SHA-256 at rest), not JWTs — no refresh secret.
JWT_REFRESH_EXPIRY_DAYS=7
