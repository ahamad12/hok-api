generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketType {
  ISSUE
  INSTRUCTION
  ANNOUNCEMENT
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum PeriodType {
  MORNING
  EVENING
}

enum ScratchPackStatus {
  ACTIVE
  FINISHED
  RETURNED
}

enum ScratchPackLocation {
  DISPLAY
  BACKSTOCK
}

enum LicenseRenewalSource {
  INITIAL
  RENEWAL
}

enum TillEntryCategory {
  SALES
  EXPENSE
  WITHDRAWAL
  DEPOSIT
}

enum DailySummaryStatus {
  DRAFT
  FINALIZED
}

enum ExpenseBucket {
  PURCHASE
  LICENSE
  SALARY
  UTILITY
  RENT
  OTHER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  role         UserRole
  shopId       String?   @map("shop_id")
  shop         Shop?     @relation("ShopStaff", fields: [shopId], references: [id], onDelete: SetNull)
  isSupervisor Boolean   @default(false) @map("is_supervisor")
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedShops               Shop[]                  @relation("ShopOwner")
  assignedTasks            Task[]                  @relation("TaskAssignee")
  createdTasks             Task[]                  @relation("TaskCreator")
  voidedTasks              Task[]                  @relation("TaskVoidedBy")
  receivedScratchPacks     ScratchPack[]           @relation("ScratchPackReceivedBy")
  scratchScanEvents        ScratchScanEvent[]      @relation("ScratchScanScannedBy")
  voidedScratchScans       ScratchScanEvent[]      @relation("ScratchScanVoidedBy")
  licenseRenewals          LicenseRenewal[]
  voidedLicenseRenewals    LicenseRenewal[]        @relation("LicenseRenewalVoidedBy")
  deliveredDeliveries      Delivery[]              @relation("DeliveryDeliveredBy")
  voidedDeliveries         Delivery[]              @relation("DeliveryVoidedBy")
  recordedDeliveryPayments DeliveryPayment[]       @relation("DeliveryPaymentRecordedBy")
  voidedDeliveryPayments   DeliveryPayment[]       @relation("DeliveryPaymentVoidedBy")
  createdTickets           Ticket[]                @relation("TicketCreator")
  assignedTickets          Ticket[]                @relation("TicketAssignee")
  ticketMessages           TicketMessage[]
  ticketAcknowledgements   TicketAcknowledgement[]
  formSubmissions          FormSubmission[]
  tillEntries              TillEntry[]
  dailySummaries           DailySummary[]          @relation("DailySummaryCreator")
  finalizedDailySummaries  DailySummary[]          @relation("DailySummaryFinalizedBy")
  voidedDailySummaries     DailySummary[]          @relation("DailySummaryVoidedBy")
  expenses                 Expense[]
  voidedExpenses           Expense[]               @relation("ExpenseVoidedBy")
  profitReports            ProfitReport[]
  voidedProfitReports      ProfitReport[]          @relation("ProfitReportVoidedBy")
  refreshTokens            RefreshToken[]

  @@index([email])
  @@index([shopId])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([role, isSupervisor])
  @@map("users")
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  REUSE_DETECTED
  PASSWORD_CHANGED
}

// One row per issued refresh token. A login starts a session (familyId);
// every refresh revokes the presented row (ROTATED) and issues its child in
// the same family. Rows are revoked, not deleted, so presenting an already
// ROTATED token is detectable as reuse (theft) and kills the whole family.
// `token` holds SHA-256(raw), never the raw value.
model RefreshToken {
  id               String                    @id @default(uuid())
  userId           String                    @map("user_id")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String                    @map("family_id")
  token            String                    @unique
  expiresAt        DateTime                  @map("expires_at")
  sessionStartedAt DateTime                  @default(now()) @map("session_started_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  revokedAt        DateTime?                 @map("revoked_at")
  revokeReason     RefreshTokenRevokeReason? @map("revoke_reason")
  replacedById     String?                   @unique @map("replaced_by_id")
  deviceName       String?                   @map("device_name") @db.VarChar(100)
  userAgent        String?                   @map("user_agent") @db.VarChar(512)
  ipAddress        String?                   @map("ip_address") @db.VarChar(64)

  @@index([userId])
  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Shop {
  id        String   @id @default(uuid())
  name      String
  address   Json
  phone     String
  logoUrl   String?  @map("logo_url")
  ownerId   String   @map("owner_id")
  owner     User     @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff             User[]             @relation("ShopStaff")
  tasks             Task[]
  scratchGames      ScratchGame[]
  scratchPacks      ScratchPack[]
  scratchScanEvents ScratchScanEvent[]
  licenses          License[]
  categories        Category[]
  suppliers         Supplier[]
  deliveries        Delivery[]
  tickets           Ticket[]
  forms             Form[]
  reports           Report[]
  tillEntries       TillEntry[]
  dailySummaries    DailySummary[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  profitReports     ProfitReport[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([isActive])
  @@index([createdAt])
  @@map("shops")
}

model Task {
  id              String     @id @default(uuid())
  shopId          String     @map("shop_id")
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title           String
  description     String?    @db.Text
  assigneeId      String?    @map("assignee_id")
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status          TaskStatus @default(NOT_STARTED)
  dueDate         DateTime?  @map("due_date")
  isRecurring     Boolean    @default(false) @map("is_recurring")
  recurringConfig Json?      @map("recurring_config")
  priority        Int        @default(0)
  createdById     String     @map("created_by_id")
  createdBy       User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt     DateTime?  @map("completed_at")
  voidedAt        DateTime?  @map("voided_at")
  voidedById      String?    @map("voided_by_id")
  voidedBy        User?      @relation("TaskVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason      String?    @map("void_reason") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([shopId, status])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([createdById])
  @@index([status, dueDate])
  @@index([shopId, voidedAt])
  @@map("tasks")
}

model ScratchGame {
  id             String   @id @default(uuid())
  shopId         String   @map("shop_id")
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  gameNumber     String?  @map("game_number")
  name           String
  priceCents     Int      @map("price_cents")
  ticketsPerPack Int      @map("tickets_per_pack")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  packs ScratchPack[]

  @@unique([shopId, name])
  @@index([shopId, isActive])
  @@map("scratch_games")
}

model ScratchPack {
  id           String              @id @default(uuid())
  gameId       String              @map("game_id")
  game         ScratchGame         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  shopId       String              @map("shop_id")
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serialStart  String              @map("serial_start") @db.VarChar(3)
  status       ScratchPackStatus   @default(ACTIVE)
  location     ScratchPackLocation
  receivedById String              @map("received_by_id")
  receivedBy   User                @relation("ScratchPackReceivedBy", fields: [receivedById], references: [id], onDelete: Cascade)
  receivedAt   DateTime            @default(now()) @map("received_at")
  finishedAt   DateTime?           @map("finished_at")
  returnedAt   DateTime?           @map("returned_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  scanEvents ScratchScanEvent[]

  @@unique([gameId, serialStart])
  @@index([shopId, status])
  @@index([shopId, location])
  @@index([gameId])
  @@map("scratch_packs")
}

model ScratchScanEvent {
  id                       String      @id @default(uuid())
  packId                   String      @map("pack_id")
  pack                     ScratchPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  gameId                   String      @map("game_id")
  shopId                   String      @map("shop_id")
  shop                     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sequenceNumber           Int         @default(autoincrement()) @map("sequence_number")
  scanDate                 DateTime    @map("scan_date") @db.Date
  shiftPeriod              PeriodType  @map("shift_period")
  scannedSerial            String      @map("scanned_serial") @db.VarChar(3)
  ticketsSoldSincePrevious Int         @map("tickets_sold_since_previous")
  ticketsRemaining         Int         @map("tickets_remaining")
  unitPriceCents           Int         @map("unit_price_cents")
  revenueCents             Int         @map("revenue_cents")
  scannedById              String      @map("scanned_by_id")
  scannedBy                User        @relation("ScratchScanScannedBy", fields: [scannedById], references: [id], onDelete: Cascade)
  voidedAt                 DateTime?   @map("voided_at")
  voidedById               String?     @map("voided_by_id")
  voidedBy                 User?       @relation("ScratchScanVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason               String?     @map("void_reason") @db.Text
  createdAt                DateTime    @default(now()) @map("created_at")

  @@index([packId, scanDate, shiftPeriod])
  @@index([packId, sequenceNumber])
  @@index([shopId, scanDate])
  @@index([shopId, gameId, scanDate])
  @@map("scratch_scan_events")
}

model License {
  id            String  @id @default(uuid())
  shopId        String  @map("shop_id")
  shop          Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productName   String  @map("product_name")
  licenseNumber String  @map("license_number")
  remindDays    Int     @default(7) @map("remind_days")
  isActive      Boolean @default(true) @map("is_active")

  // Denormalized cache of the latest LicenseRenewal — avoids a
  // DISTINCT-ON/window-function query on every list/expiring read.
  // Refreshed transactionally whenever a LicenseRenewal is written.
  // Nullable only because License must exist before its first renewal
  // row can reference it; application guarantees non-null post-create.
  currentRenewalId  String?         @unique @map("current_renewal_id")
  currentRenewal    LicenseRenewal? @relation("LicenseCurrentRenewal", fields: [currentRenewalId], references: [id], onDelete: SetNull)
  currentIssueDate  DateTime?       @map("current_issue_date") @db.Date
  currentExpiryDate DateTime?       @map("current_expiry_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  renewals LicenseRenewal[] @relation("LicenseRenewals")

  @@unique([shopId, licenseNumber])
  @@index([shopId, currentExpiryDate])
  @@index([isActive])
  @@index([currentExpiryDate])
  @@map("licenses")
}

model LicenseRenewal {
  id            String               @id @default(uuid())
  licenseId     String               @map("license_id")
  license       License              @relation("LicenseRenewals", fields: [licenseId], references: [id], onDelete: Cascade)
  source        LicenseRenewalSource
  issueDate     DateTime             @map("issue_date") @db.Date
  expiryDate    DateTime             @map("expiry_date") @db.Date
  paymentAmount Int?                 @map("payment_amount") // cents; null on INITIAL if no payment was recorded
  paymentDate   DateTime?            @map("payment_date") @db.Date
  documentUrl   String?              @map("document_url")
  notes         String?              @db.Text
  recordedById  String               @map("recorded_by_id")
  recordedBy    User                 @relation(fields: [recordedById], references: [id], onDelete: Cascade)
  voidedAt      DateTime?            @map("voided_at")
  voidedById    String?              @map("voided_by_id")
  voidedByUser  User?                @relation("LicenseRenewalVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason    String?              @map("void_reason") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")

  currentFor License? @relation("LicenseCurrentRenewal")

  @@index([licenseId, createdAt])
  @@index([licenseId, expiryDate])
  @@map("license_renewals")
}

model Category {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  suppliers Supplier[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([shopId, name])
  @@index([isActive])
  @@map("categories")
}

model Supplier {
  id         String   @id @default(uuid())
  shopId     String   @map("shop_id")
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  phone      String?
  address    String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([categoryId])
  @@index([shopId, isActive])
  @@index([name])
  @@map("suppliers")
}

model Delivery {
  id         String   @id @default(uuid())
  shopId     String   @map("shop_id")
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  billUrl    String?  @map("bill_url")

  // Cached from line items at creation — line items are immutable after
  // creation (a wrong one means voiding the whole delivery), so this
  // never needs recomputation outside that path.
  totalAmountCents Int @map("total_amount_cents")

  // Cached running sum of non-voided DeliveryPayment.amountCents —
  // same denormalization pattern as License.currentExpiryDate.
  // Refreshed transactionally on every payment record/void via a
  // guarded updateMany (WHERE totalPaidCents <= limit) so concurrent
  // writers can't both push the sum past totalAmountCents.
  totalPaidCents Int @default(0) @map("total_paid_cents")

  deliveredById String   @map("delivered_by_id")
  deliveredBy   User     @relation("DeliveryDeliveredBy", fields: [deliveredById], references: [id], onDelete: Cascade)
  deliveredAt   DateTime @default(now()) @map("delivered_at")

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidedBy   User?     @relation("DeliveryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?   @map("void_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems DeliveryLineItem[]
  payments  DeliveryPayment[]

  @@index([shopId, deliveredAt])
  @@index([supplierId, deliveredAt])
  @@index([deliveredAt])
  @@map("deliveries")
}

model DeliveryLineItem {
  id               String   @id @default(uuid())
  deliveryId       String   @map("delivery_id")
  // Restrict, not Cascade — nothing hard-deletes a Delivery in this
  // module (void only), and a stray DELETE shouldn't silently erase
  // receiving history.
  delivery         Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  productName      String   @map("product_name")
  quantityOrdered  Float    @map("quantity_ordered")
  quantityReceived Float    @map("quantity_received")
  unit             String
  unitPriceCents   Int      @map("unit_price_cents")
  lineTotalCents   Int      @map("line_total_cents") // round(quantityReceived * unitPriceCents), snapshotted at creation
  discrepancyNote  String?  @map("discrepancy_note") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([deliveryId])
  @@map("delivery_line_items")
}

model DeliveryPayment {
  id           String      @id @default(uuid())
  deliveryId   String      @map("delivery_id")
  // Restrict, not Cascade — payment history is the financial record of
  // money that actually changed hands; it must never vanish via cascade.
  delivery     Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  amountCents  Int         @map("amount_cents")
  paymentMode  PaymentMode @map("payment_mode")
  paidAt       DateTime    @default(now()) @map("paid_at")
  recordedById String      @map("recorded_by_id")
  recordedBy   User        @relation("DeliveryPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)
  notes        String?     @db.Text

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidedBy   User?     @relation("DeliveryPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?   @map("void_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deliveryId, paidAt])
  @@map("delivery_payments")
}

model Ticket {
  id               String         @id @default(uuid())
  shopId           String         @map("shop_id")
  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type             TicketType     @default(ISSUE)
  subject          String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(NORMAL)
  requiresAck      Boolean        @default(false) @map("requires_ack")
  createdById      String         @map("created_by_id")
  createdBy        User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assigneeId       String?        @map("assignee_id")
  assignee         User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creationClientId String?        @map("creation_client_id") // idempotency key for create; hard-enforced via partial unique index in migration (see migrations/<ts>_ticket_idempotency_hard_guards)
  resolvedAt       DateTime?      @map("resolved_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  messages         TicketMessage[]
  acknowledgements TicketAcknowledgement[]

  @@index([shopId, status])
  @@index([createdById])
  @@index([status, priority])
  @@index([shopId, type, status])
  @@index([assigneeId])
  @@map("tickets")
}

model TicketMessage {
  id              String   @id @default(uuid())
  ticketId        String   @map("ticket_id")
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId        String   @map("sender_id")
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message         String   @db.Text
  mediaUrl        String?  @map("media_url")
  clientMessageId String?  @map("client_message_id") // idempotency key; hard-enforced via partial unique index, same migration
  sequence        Int      @default(autoincrement()) @map("sequence") // global monotonic counter, not per-ticket 1..N — sufficient for ordering + cursor pagination (@@index([ticketId, sequence])); do not "fix" gaps, they're expected
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ticketId, sequence])
  @@index([ticketId, createdAt])
  @@index([senderId])
  @@map("ticket_messages")
}

model TicketAcknowledgement {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_acknowledgements")
}

model Form {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  schema      Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions FormSubmission[]

  @@index([shopId, isActive])
  @@index([shopId, createdAt])
  @@map("forms")
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String   @map("form_id")
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  staffId     String   @map("staff_id")
  staff       User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  answers     Json
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@index([formId])
  @@index([staffId])
  @@index([submittedAt])
  @@map("form_submissions")
}

model TillEntry {
  id               String            @id @default(uuid())
  shopId           String            @map("shop_id")
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         TillEntryCategory
  amount           Int
  description      String?           @db.Text
  billUrl          String?           @map("bill_url")
  recordedById     String            @map("recorded_by_id")
  recordedBy       User              @relation(fields: [recordedById], references: [id], onDelete: Cascade)
  transactionDate  DateTime          @default(now()) @map("transaction_date")
  reversesEntryId  String?           @map("reverses_entry_id")
  reversedEntry    TillEntry?        @relation("TillEntryReversal", fields: [reversesEntryId], references: [id])
  reversals        TillEntry[]       @relation("TillEntryReversal")
  correctionReason String?           @map("correction_reason") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")

  @@unique([reversesEntryId])
  @@index([shopId, transactionDate])
  @@index([shopId, category, transactionDate])
  @@index([transactionDate])
  @@map("till_entries")
}

model DailySummary {
  id     String             @id @default(uuid())
  shopId String             @map("shop_id")
  shop   Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date   DateTime           @db.Date
  status DailySummaryStatus @default(DRAFT)

  openingBalance  Int @map("opening_balance")
  closingBalance  Int @map("closing_balance") // as counted/entered by the preparer
  totalCashIn     Int @map("total_cash_in")
  totalCashOut    Int @map("total_cash_out")
  scratchRevenue  Int @map("scratch_revenue")
  deliveryExpense Int @map("delivery_expense")
  otherIncome     Int @map("other_income")
  otherExpense    Int @map("other_expense")

  // expected = opening + totalCashIn - totalCashOut + scratchRevenue
  //          - deliveryExpense + otherIncome - otherExpense
  // variance = closingBalance - expected ("over" if positive, "short" if negative)
  // Stored, not recomputed on read — a finalized report's variance must
  // never drift even if a later correction changes an underlying aggregate
  // method; it reflects what was known and closed on that date.
  variance Int @default(0)

  // Point-in-time drill-down snapshot: till category totals, scratch
  // revenue per game, delivery totals per supplier, expense totals per
  // category — computed once at creation, never recomputed. Same pattern
  // as Form.schema / FormSubmission.answers: structured data that doesn't
  // need to be queried or indexed on its own, only displayed.
  breakdown Json

  notes String? @db.Text

  createdById String @map("created_by_id")
  createdBy   User   @relation("DailySummaryCreator", fields: [createdById], references: [id], onDelete: Cascade)

  finalizedAt   DateTime? @map("finalized_at")
  finalizedById String?   @map("finalized_by_id")
  finalizedBy   User?     @relation("DailySummaryFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidedBy   User?     @relation("DailySummaryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?   @map("void_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // NOTE: the plain @@unique([shopId, date]) that used to be here is
  // REMOVED — replaced by a partial unique index in the migration below
  // (WHERE voided_at IS NULL), so a voided summary can be re-closed for
  // the same date without permanently blocking that date forever.
  @@index([shopId, date])
  @@index([shopId, status])
  @@index([date])
  @@map("daily_summaries")
}

model ExpenseCategory {
  id          String        @id @default(uuid())
  shopId      String?       @map("shop_id")
  shop        Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?       @db.Text
  bucket      ExpenseBucket @default(OTHER) @map("bucket")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  expenses Expense[]

  @@index([shopId])
  @@index([isActive])
  @@index([bucket])
  @@map("expense_categories")
}

model Expense {
  id           String          @id @default(uuid())
  shopId       String          @map("shop_id")
  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId   String          @map("category_id")
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount       Int
  description  String          @db.Text
  billUrl      String?         @map("bill_url")
  expenseDate  DateTime        @map("expense_date") @db.Date
  recordedById String          @map("recorded_by_id")
  recordedBy   User            @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  // Void pattern — matches Task/Delivery/DeliveryPayment/ScratchScanEvent/
  // LicenseRenewal. A wrong expense is corrected by voiding, never
  // hard-deleted — the audit trail of "money was recorded as spent" is
  // never erased.
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidedBy   User?     @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?   @map("void_reason") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([shopId, expenseDate])
  @@index([categoryId])
  @@index([expenseDate])
  @@index([shopId, voidedAt])
  @@map("expenses")
}

model ProfitReport {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  scratchRevenue  Int @map("scratch_revenue")
  deliveryRevenue Int @map("delivery_revenue")
  otherRevenue    Int @map("other_revenue")
  totalRevenue    Int @map("total_revenue")

  purchaseCost   Int @map("purchase_cost")
  deliveryCost   Int @map("delivery_cost")
  licenseFees    Int @map("license_fees")
  salaryExpense  Int @map("salary_expense")
  utilityExpense Int @map("utility_expense")
  rentExpense    Int @map("rent_expense")
  otherExpense   Int @map("other_expense")
  totalExpense   Int @map("total_expense")

  grossProfit  Int   @map("gross_profit")
  netProfit    Int   @map("net_profit")
  profitMargin Float @map("profit_margin")

  scratchCardsCount Int @map("scratch_cards_count")
  inventoryValue    Int @map("inventory_value")

  generatedAt   DateTime @default(now()) @map("generated_at")
  generatedById String   @map("generated_by_id")
  generatedBy   User     @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidedBy   User?     @relation("ProfitReportVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?   @map("void_reason") @db.Text

  reports Report[]

  // "one live report per period" is a partial unique index in the migration
  // (WHERE voided_at IS NULL) — Prisma can't express it, this index is speed only.
  @@index([shopId, periodStart, periodEnd])
  @@index([generatedAt])
  @@map("profit_reports")
}

model Report {
  id             String        @id @default(uuid())
  shopId         String        @map("shop_id")
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type           String
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  format         String
  url            String
  profitReportId String?       @map("profit_report_id")
  profitReport   ProfitReport? @relation(fields: [profitReportId], references: [id], onDelete: SetNull)
  generatedAt    DateTime      @default(now()) @map("generated_at")

  @@index([shopId, type])
  @@index([shopId, generatedAt])
  @@index([profitReportId])
  @@map("reports")
}
