{
  "name": "tapt-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types && npm --prefix apps/server run check:enums",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @tapt-api/db db:push",
    "db:studio": "turbo -F @tapt-api/db db:studio",
    "db:generate": "turbo -F @tapt-api/db db:generate",
    "db:migrate": "turbo -F @tapt-api/db db:migrate",
    "db:start": "turbo -F @tapt-api/db db:start",
    "db:watch": "turbo -F @tapt-api/db db:watch",
    "db:stop": "turbo -F @tapt-api/db db:stop",
    "db:down": "turbo -F @tapt-api/db db:down",
    "check": "biome check --write .",
    "check:ws-write-guard": "bash -c 'if grep -rq \"@SubscribeMessage\" apps/server/src/infra/gateway apps/server/src/modules; then echo \"WS write path detected — WsThrottlerGuard was deferred pending this. See apps/server/src/common/guards/user-throttler.guard.ts and plan: keep HTTP-only until @SubscribeMessage exists; when adding, use per-user socket.data.user.userId vs handshake.address vs client.id tradeoff.\"; exit 1; fi; echo \"WS write guard check passed (0 @SubscribeMessage hits, HTTP-only)\"'",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.65.0",
    "@sentry/profiling-node": "^10.65.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tapt-api/env": "*",
    "@ts-rest/nest": "^3.52.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tapt-api/config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs,json,jsonc}": "biome check --write"
  },
  "packageManager": "npm@10.9.0"
}
